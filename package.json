{
  "name": "lights-camera-action",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell.exe -NoProfile -File ./start.ps1",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node -e \"console.log('Unit tests are disabled. No tests were run.')\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "antd": "^5.29.3",
    "lucide": "0.468.0",
    "lucide-react": "0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
